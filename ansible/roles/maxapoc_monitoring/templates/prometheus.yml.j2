global:
  scrape_interval: {{ maxapoc_monitoring_scrape_interval }}

scrape_configs:
  - job_name: maxapoc-proxy
    scrape_interval: {{ maxapoc_monitoring_scrape_interval }}
    scrape_timeout: {{ maxapoc_monitoring_scrape_timeout }}
    static_configs:
      - targets: ['{{ maxapoc_monitoring_proxy_target }}']
        labels: { service: maxapoc }

rule_files:
  - /etc/prometheus/rules/*.yml
  
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']
